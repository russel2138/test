#!/usr/bin/env bash
set -uo pipefail

RUNDIR=/run/nro
LOGDIR=/tmp
mkdir -p "$RUNDIR"

components=(display game)

valid_component() {
  case "$1" in
    display|game) return 0 ;;
    *) return 1 ;;
  esac
}

pidfile() {
  printf '%s/%s.pid' "$RUNDIR" "$1"
}

alive() {
  local file pid
  file="$(pidfile "$1")"
  [[ -s "$file" ]] || return 1
  pid="$(cat "$file" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

start_one() {
  local c="$1" file p
  file="$(pidfile "$c")"

  if alive "$c"; then
    echo "[$c] already ON pid=$(cat "$file")"
    return 0
  fi

  rm -f "$file"
  nohup "/app/run-$c.sh" >>"$LOGDIR/nro-$c.log" 2>&1 </dev/null &
  p=$!
  echo "$p" >"$file"

  sleep 0.5
  if kill -0 "$p" 2>/dev/null; then
    echo "[$c] ON pid=$p"
    return 0
  fi

  echo "[$c] failed to start; see $LOGDIR/nro-$c.log" >&2
  tail -n 80 "$LOGDIR/nro-$c.log" 2>/dev/null || true
  rm -f "$file"
  return 1
}

stop_one() {
  local c="$1" file p=""
  file="$(pidfile "$c")"
  [[ -s "$file" ]] && p="$(cat "$file" 2>/dev/null || true)"

  if [[ -n "$p" ]]; then
    kill "$p" 2>/dev/null || true
    for _ in {1..15}; do
      kill -0 "$p" 2>/dev/null || break
      sleep 0.1
    done
    kill -9 "$p" 2>/dev/null || true
  fi

  rm -f "$file"
  echo "[$c] OFF"
}

status_one() {
  local c="$1" p="-" state="OFF" proc="-"
  if alive "$c"; then
    p="$(cat "$(pidfile "$c")")"
    state="ON"
    proc="$(cat "/proc/$p/comm" 2>/dev/null | tr -d '\n' || true)"
  fi
  printf '%-8s %-3s pid=%-6s process=%s\n' "$c" "$state" "$p" "${proc:--}"
}

status_all() {
  echo "=== NRO / BLITZ ==="
  status_one display
  status_one game
  echo
  echo "game     : /app/game.jar ($(stat -c%s /app/game.jar 2>/dev/null || echo '?') bytes)"
  echo "state    : /data/microemu-home/.microemulator"
  echo "watchdog : OFF"
  echo "restart  : manual only"
}

start_all() {
  start_one display || true
  start_one game || true
}

stop_all() {
  stop_one game
  stop_one display
}

usage() {
  cat <<'EOF'
Usage:
  /app/nroctl status
  /app/nroctl start   <display|game|all>
  /app/nroctl stop    <display|game|all>
  /app/nroctl restart <display|game|all>
  /app/nroctl log     <display|game>

No watchdog. No automatic restart loop.
EOF
}

action="${1:-status}"
target="${2:-all}"

case "$action" in
  status)
    if [[ "$target" == "all" ]]; then
      status_all
    elif valid_component "$target"; then
      status_one "$target"
    else
      usage; exit 2
    fi
    ;;
  start)
    if [[ "$target" == "all" ]]; then
      start_all
    elif valid_component "$target"; then
      start_one "$target"
    else
      usage; exit 2
    fi
    ;;
  stop)
    if [[ "$target" == "all" ]]; then
      stop_all
    elif valid_component "$target"; then
      stop_one "$target"
    else
      usage; exit 2
    fi
    ;;
  restart)
    if [[ "$target" == "all" ]]; then
      stop_all
      sleep 0.5
      start_all
    elif valid_component "$target"; then
      stop_one "$target"
      start_one "$target"
    else
      usage; exit 2
    fi
    ;;
  log|logs)
    valid_component "$target" || { usage; exit 2; }
    tail -n 120 "$LOGDIR/nro-$target.log" 2>/dev/null || true
    ;;
  *)
    usage
    exit 2
    ;;
esac
