#!/usr/bin/env bash
set -uo pipefail

RUNDIR=/run/nro
LOGDIR=/tmp
mkdir -p "$RUNDIR"

components=(display vnc web game)

valid_component() {
  local wanted="$1" c
  for c in "${components[@]}"; do
    [[ "$c" == "$wanted" ]] && return 0
  done
  return 1
}

pidfile() {
  printf '%s/%s.pid' "$RUNDIR" "$1"
}

alive() {
  local file pid
  file="$(pidfile "$1")"
  [[ -s "$file" ]] || return 1
  pid="$(cat "$file" 2>/dev/null || true)"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

start_one() {
  local c="$1" file p
  file="$(pidfile "$c")"

  if alive "$c"; then
    echo "[$c] already ON pid=$(cat "$file")"
    return 0
  fi

  rm -f "$file"
  nohup "/app/run-$c.sh" >>"$LOGDIR/nro-$c.log" 2>&1 </dev/null &
  p=$!
  echo "$p" >"$file"

  sleep 0.5
  if kill -0 "$p" 2>/dev/null; then
    echo "[$c] ON pid=$p"
    return 0
  fi

  echo "[$c] failed to start; see $LOGDIR/nro-$c.log" >&2
  tail -n 40 "$LOGDIR/nro-$c.log" 2>/dev/null || true
  rm -f "$file"
  return 1
}

stop_one() {
  local c="$1" file p=""
  file="$(pidfile "$c")"

  [[ -s "$file" ]] && p="$(cat "$file" 2>/dev/null || true)"
  if [[ -n "$p" ]]; then
    kill "$p" 2>/dev/null || true
    for _ in {1..15}; do
      kill -0 "$p" 2>/dev/null || break
      sleep 0.1
    done
    kill -9 "$p" 2>/dev/null || true
  fi

  rm -f "$file"
  echo "[$c] OFF"
}

status_one() {
  local c="$1" p="-" state="OFF" proc="-"
  if alive "$c"; then
    p="$(cat "$(pidfile "$c")")"
    state="ON"
    proc="$(cat "/proc/$p/comm" 2>/dev/null | tr -d '\n' || true)"
  fi
  printf '%-8s %-3s pid=%-6s process=%s\n' "$c" "$state" "$p" "${proc:--}"
}

status_all() {
  local c
  echo "=== NRO STATUS ==="
  for c in "${components[@]}"; do
    status_one "$c"
  done
  echo
  [[ -s /data/game.jar ]] && echo "game.jar : OK ($(stat -c%s /data/game.jar 2>/dev/null || echo '?') bytes)" || echo "game.jar : MISSING"
  echo "state    : /data/microemu-home/.microemulator"
  echo "web      : https://nro.pyoska.blitz.cloud"
  [[ -s /data/vnc-password.txt ]] && echo "vnc pass : $(head -n1 /data/vnc-password.txt)"
  echo "watchdog : OFF"
  echo "restart  : manual only"
}

start_all() {
  start_one display || true
  start_one vnc || true
  start_one web || true
  if [[ -s /data/game.jar ]]; then
    start_one game || true
  else
    echo "[game] skipped: /data/game.jar missing"
  fi
}

stop_all() {
  stop_one game
  stop_one web
  stop_one vnc
  stop_one display
}

usage() {
  cat <<'EOF'
Usage:
  nroctl status
  nroctl start   <display|game|vnc|web|all|remote>
  nroctl stop    <display|game|vnc|web|all|remote>
  nroctl restart <display|game|vnc|web|all|remote>
  nroctl log     <display|game|vnc|web>

remote = vnc + web
No watchdog. No automatic restart loop.
EOF
}

action="${1:-status}"
target="${2:-all}"

expand_targets() {
  case "$1" in
    all) printf '%s\n' display vnc web game ;;
    remote) printf '%s\n' vnc web ;;
    *) valid_component "$1" && printf '%s\n' "$1" || return 1 ;;
  esac
}

case "$action" in
  status)
    if [[ "${2:-}" != "" && "${2:-}" != "all" ]]; then
      valid_component "$2" || { usage; exit 2; }
      status_one "$2"
    else
      status_all
    fi
    ;;
  start)
    if [[ "$target" == "all" ]]; then
      start_all
    else
      mapfile -t targets < <(expand_targets "$target") || { usage; exit 2; }
      for c in "${targets[@]}"; do start_one "$c"; done
    fi
    ;;
  stop)
    if [[ "$target" == "all" ]]; then
      stop_all
    else
      mapfile -t targets < <(expand_targets "$target") || { usage; exit 2; }
      for c in "${targets[@]}"; do stop_one "$c"; done
    fi
    ;;
  restart)
    if [[ "$target" == "all" ]]; then
      stop_all
      sleep 0.5
      start_all
    else
      mapfile -t targets < <(expand_targets "$target") || { usage; exit 2; }
      for c in "${targets[@]}"; do stop_one "$c"; start_one "$c"; done
    fi
    ;;
  log|logs)
    valid_component "$target" || { usage; exit 2; }
    tail -n 120 "$LOGDIR/nro-$target.log" 2>/dev/null || true
    ;;
  *)
    usage
    exit 2
    ;;
esac
